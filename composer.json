{
    "name": "neo-digital/contao-websitecheck-bundle",
    "type": "contao-bundle",
    "description": "Website check for Contao 5: visitors enter a domain, the bundle measures it with Google PageSpeed Insights, runs its own HTML/legal/AI-visibility checks, lets an LLM read the site like a visitor, grades everything with school grades and shows the result in exchange for name and e-mail, and emails a PDF report (to the visitor with a licence, to the site operator without one). Lead magnet for agencies and freelancers.",
    "keywords": [
        "contao",
        "contao-bundle",
        "website-check",
        "audit",
        "pagespeed",
        "lighthouse",
        "accessibility",
        "seo",
        "lead-generation",
        "llms.txt"
    ],
    "homepage": "https://github.com/NEO-Digital-AT/contao-websitecheck-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "NEO Digital"
        }
    ],
    "support": {
        "issues": "https://github.com/NEO-Digital-AT/contao-websitecheck-bundle/issues",
        "source": "https://github.com/NEO-Digital-AT/contao-websitecheck-bundle"
    },
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "contao/core-bundle": "^5.3 || ^6.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "dompdf/dompdf": "^3.0",
        "neo-digital/contao-basic-bundle": "^1.0",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/mailer": "^6.4 || ^7.0 || ^8.0",
        "symfony/mime": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/twig-bridge": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "suggest": {
        "contao/newsletter-bundle": "Newsletter checkbox with Contao’s own double opt-in (used when the Brevo newsletter module is not installed).",
        "neo-digital/contao-brevo-bundle": "Newsletter checkbox via Brevo, with the API key from that module’s back-end settings."
    },
    "autoload": {
        "psr-4": {
            "Neo\\WebsitecheckBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neo\\WebsitecheckBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "contao-manager-plugin": "Neo\\WebsitecheckBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
