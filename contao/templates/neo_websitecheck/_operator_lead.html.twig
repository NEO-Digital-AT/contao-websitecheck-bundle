{% trans_default_domain 'neo_websitecheck' %}
{#
  Without a licence the e-mail designed for the visitor goes to the site
  operator only (ReportRenderer::renderMailForOperator): this box on top names
  the visitor and says that the visitor did not get the e-mail.
#}
{% set p = brand.color_primary %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:24px 12px 0;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#fff8e6;border:1px solid #ffd27a;border-radius:12px;font-family:Helvetica,Arial,sans-serif;color:#1a1a1a;"><tr><td style="padding:14px 16px;font-size:14px;line-height:1.7;">
  <b style="color:{{ p }};">{{ 'mail.owner_lead_title'|trans }}</b><br>
  {{ first_name }} {{ last_name }} · <a href="mailto:{{ email }}" style="color:{{ p }};">{{ email }}</a><br>
  {{ result.domain }} · {{ 'report.grade_line'|trans({'%grade%': result.grade, '%word%': result.gradeWord}) }}<br>
  {{ 'mail.owner_contact'|trans }}: {{ (contact|default(false) ? 'word.yes' : 'word.no')|trans }}<br>
  <span style="font-size:13px;color:#5c4a1a;">{{ 'mail.operator_only'|trans({'%id%': check.id}) }}</span>
</td></tr></table>
</td></tr></table>
